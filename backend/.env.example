# MediBridge AI Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# Production Architecture: NVIDIA Cloud STT + Deterministic Extraction
# No local models. No Ollama. No GPU required.

# ── Server ────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=medibridge_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OCR Settings ─────────────────────────────────────────────
OCR_LANG=en
OCR_USE_GPU=false
OCR_MAX_FILE_SIZE_MB=10

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./kenko_clinical.db

# ── Temp Directory ────────────────────────────────────────────
TEMP_DIR=

# ── NVIDIA Hosted Speech-to-Text (Cloud API — server-side only) ──
# SECURITY: NEVER put NVIDIA_API_KEY in frontend code.
# SECURITY: NEVER commit .env to version control.
# Model options: openai/whisper-large-v3 | openai/whisper-large-v3-turbo | nvidia/canary-1b
NVIDIA_API_KEY=
NVIDIA_STT_MODEL=openai/whisper-large-v3
NVIDIA_STT_ENDPOINT=https://integrate.api.nvidia.com/v1/audio/transcriptions
NVIDIA_MAX_AUDIO_SIZE_MB=25

# ── Google Meet REST API v2 & OAuth 2.0 ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
FRONTEND_URL=http://localhost:5173

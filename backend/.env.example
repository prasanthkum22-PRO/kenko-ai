# MediBridge AI Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=medibridge_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Local AI / LLM (Ollama) ──────────────────────────────────
# Default Ollama REST endpoint
OLLAMA_URL=http://localhost:11434
# Recommended models: qwen2.5:7b, qwen2.5:3b, llama3.2:3b, mistral:7b
OLLAMA_MODEL=qwen2.5:7b

# ── Speech-to-Text (faster-whisper) ───────────────────────────
# Model size: tiny | base | small | medium | large-v3 (default: small)
WHISPER_MODEL=small

# ── Diarization (Optional pyannote.audio) ─────────────────────
# Hugging Face token (leave empty for built-in offline heuristic diarization)
HF_TOKEN=

# ── OCR Settings ─────────────────────────────────────────────
OCR_LANG=en
OCR_USE_GPU=false
OCR_MAX_FILE_SIZE_MB=10

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./kenko_clinical.db

# ── Temp Directory ────────────────────────────────────────────
TEMP_DIR=


# MediBridge AI / KENKO AI Environment Configuration Example
# Copy this file to .env and configure for your local/production environment

# Frontend Vite Server
VITE_API_BASE_URL=http://localhost:8000

# Backend Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Auth
JWT_SECRET=medibridge_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local AI / LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# NVIDIA Hosted Speech-to-Text (Server-side Only)
NVIDIA_API_KEY=
NVIDIA_STT_MODEL=openai/whisper-large-v3
NVIDIA_STT_ENDPOINT=https://integrate.api.nvidia.com/v1/audio/transcriptions
NVIDIA_MAX_AUDIO_SIZE_MB=25

# Google Meet REST API v2 & OAuth 2.0 (Server-side Only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./kenko_clinical.db
